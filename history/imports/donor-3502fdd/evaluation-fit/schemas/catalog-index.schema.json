{
  "$defs": {
    "CatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/CatalogObjectKind"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_schema_version": {
          "minLength": 1,
          "title": "Object Schema Version",
          "type": "string"
        },
        "schema_version": {
          "const": "tabu.catalog-entry.v1",
          "default": "tabu.catalog-entry.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "kind",
        "object_id",
        "object_schema_version",
        "object_hash",
        "source_hash",
        "source_path",
        "data"
      ],
      "title": "CatalogEntry",
      "type": "object"
    },
    "CatalogObjectKind": {
      "enum": [
        "model_contract",
        "experiment",
        "run",
        "run_attempt",
        "receipt",
        "model_artifact",
        "dataset_snapshot",
        "eval_suite",
        "eval_result",
        "eval_comparison",
        "review",
        "claim",
        "verification_suite",
        "verification_result"
      ],
      "title": "CatalogObjectKind",
      "type": "string"
    },
    "CatalogSourceRevision": {
      "additionalProperties": false,
      "description": "Reviewed GitHub revision that exactly binds one catalog source tree.\n\nThe repository URI contains no file path or mutable branch. ``commit`` is a\nfull Git object ID, and ``catalog_source_tree_hash`` binds the declaration to\nthe canonical manifests indexed by :class:`CatalogIndex`.",
      "properties": {
        "catalog_source_tree_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Source Tree Hash",
          "type": "string"
        },
        "commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit",
          "type": "string"
        },
        "repository_uri": {
          "minLength": 1,
          "title": "Repository Uri",
          "type": "string"
        },
        "schema_version": {
          "const": "tabu.catalog-source-revision.v1",
          "default": "tabu.catalog-source-revision.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "repository_uri",
        "commit",
        "catalog_source_tree_hash"
      ],
      "title": "CatalogSourceRevision",
      "type": "object"
    },
    "JsonValue": {},
    "LineageEdge": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Hash"
        },
        "relation": {
          "$ref": "#/$defs/LineageRelation"
        },
        "schema_version": {
          "const": "tabu.lineage-edge.v1",
          "default": "tabu.lineage-edge.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ObjectRef"
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "source",
        "relation",
        "target"
      ],
      "title": "LineageEdge",
      "type": "object"
    },
    "LineageRelation": {
      "enum": [
        "implements",
        "uses_data",
        "produced",
        "evaluated_by",
        "supports",
        "resumes_from",
        "supersedes",
        "verified_by"
      ],
      "title": "LineageRelation",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "kind": {
          "$ref": "#/$defs/CatalogObjectKind"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "tabu.catalog-object-ref.v1",
          "default": "tabu.catalog-object-ref.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "$id": "https://research.wehub.us/schemas/catalog-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineageEdge"
      },
      "title": "Lineage",
      "type": "array"
    },
    "schema_version": {
      "const": "tabu.catalog-index.v1",
      "default": "tabu.catalog-index.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogSourceRevision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_tree_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Tree Hash",
      "type": "string"
    }
  },
  "required": [
    "source_tree_hash"
  ],
  "title": "CatalogIndex",
  "type": "object"
}
