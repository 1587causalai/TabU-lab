{
  "$defs": {
    "BaselineSpec": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Baseline Id",
          "type": "string"
        },
        "family": {
          "enum": [
            "majority",
            "mean",
            "mean_mode",
            "ohe_logistic",
            "standardized_ridge",
            "numeric_knn",
            "global_mode",
            "neighbor_mode",
            "global_mean",
            "user_item_bias"
          ],
          "title": "Family",
          "type": "string"
        },
        "fit_partition": {
          "const": "train",
          "default": "train",
          "title": "Fit Partition",
          "type": "string"
        },
        "hyperparameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Hyperparameters",
          "type": "object"
        },
        "schema_version": {
          "const": "tabu.eval-baseline.v1",
          "default": "tabu.eval-baseline.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "family"
      ],
      "title": "BaselineSpec",
      "type": "object"
    },
    "DatasetRequirement": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "network_required": {
          "title": "Network Required",
          "type": "boolean"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "metadata_only",
            "forbidden"
          ],
          "title": "Redistribution",
          "type": "string"
        },
        "required_partitions": {
          "default": [
            "train",
            "validation",
            "test"
          ],
          "items": {
            "enum": [
              "train",
              "validation",
              "test"
            ],
            "type": "string"
          },
          "title": "Required Partitions",
          "type": "array"
        },
        "schema_version": {
          "const": "tabu.eval-dataset-requirement.v1",
          "default": "tabu.eval-dataset-requirement.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_hash_policy": {
          "const": "require_sha256_at_run",
          "default": "require_sha256_at_run",
          "title": "Snapshot Hash Policy",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "dataset_id",
        "source_uri",
        "source_version",
        "license_id",
        "redistribution",
        "network_required"
      ],
      "title": "DatasetRequirement",
      "type": "object"
    },
    "EvaluationBudget": {
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "const": true,
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "device_class": {
          "const": "single_device",
          "default": "single_device",
          "title": "Device Class",
          "type": "string"
        },
        "max_adapter_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Max Adapter Seconds",
          "type": "integer"
        },
        "max_fit_iterations": {
          "default": 400,
          "exclusiveMinimum": 0,
          "title": "Max Fit Iterations",
          "type": "integer"
        },
        "model_seeds": {
          "default": [
            1729,
            2718,
            31415
          ],
          "items": {
            "type": "integer"
          },
          "title": "Model Seeds",
          "type": "array"
        },
        "schema_version": {
          "const": "tabu.eval-budget.v1",
          "default": "tabu.eval-budget.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "EvaluationBudget",
      "type": "object"
    },
    "JsonValue": {},
    "MaskSpec": {
      "additionalProperties": false,
      "properties": {
        "applied_after_split": {
          "const": true,
          "default": true,
          "title": "Applied After Split",
          "type": "boolean"
        },
        "fraction": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Fraction",
          "type": "number"
        },
        "independent_seed_role": {
          "const": "mask_seed",
          "default": "mask_seed",
          "title": "Independent Seed Role",
          "type": "string"
        },
        "natural_missing_excluded": {
          "const": true,
          "default": true,
          "title": "Natural Missing Excluded",
          "type": "boolean"
        },
        "schema_version": {
          "const": "tabu.eval-mask.v1",
          "default": "tabu.eval-mask.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "statistics_partition": {
          "const": "train",
          "default": "train",
          "title": "Statistics Partition",
          "type": "string"
        },
        "truth_sidecar_required": {
          "const": true,
          "default": true,
          "title": "Truth Sidecar Required",
          "type": "boolean"
        }
      },
      "required": [
        "fraction"
      ],
      "title": "MaskSpec",
      "type": "object"
    },
    "MetricDirection": {
      "enum": [
        "lower",
        "higher"
      ],
      "title": "MetricDirection",
      "type": "string"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/MetricDirection"
        },
        "metric_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "sample_rescorable": {
          "const": true,
          "default": true,
          "title": "Sample Rescorable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "tabu.eval-metric.v1",
          "default": "tabu.eval-metric.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "train_only_normalization": {
          "default": false,
          "title": "Train Only Normalization",
          "type": "boolean"
        }
      },
      "required": [
        "metric_id",
        "direction"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "ScenarioSpec": {
      "additionalProperties": false,
      "properties": {
        "applicable_contracts": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Applicable Contracts",
          "type": "array"
        },
        "applicable_profiles": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Applicable Profiles",
          "type": "array"
        },
        "baselines": {
          "items": {
            "$ref": "#/$defs/BaselineSpec"
          },
          "minItems": 1,
          "title": "Baselines",
          "type": "array"
        },
        "checkpoint_selection_partition": {
          "const": "validation",
          "default": "validation",
          "title": "Checkpoint Selection Partition",
          "type": "string"
        },
        "dataset": {
          "$ref": "#/$defs/DatasetRequirement"
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricSpec"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "preprocessing_fit_partition": {
          "const": "train",
          "default": "train",
          "title": "Preprocessing Fit Partition",
          "type": "string"
        },
        "response_columns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Columns"
        },
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "tabu.eval-scenario.v1",
          "default": "tabu.eval-scenario.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/SelectionSpec"
        },
        "statistics_fit_scope": {
          "default": "selected_train",
          "enum": [
            "selected_train",
            "full_train_partition"
          ],
          "title": "Statistics Fit Scope",
          "type": "string"
        },
        "target_kinds": {
          "items": {
            "$ref": "#/$defs/TargetKind"
          },
          "minItems": 1,
          "title": "Target Kinds",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/TaskKind"
        },
        "topology_contract_checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Topology Contract Checks",
          "type": "array"
        },
        "truth_partition": {
          "const": "test",
          "default": "test",
          "title": "Truth Partition",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "task",
        "dataset",
        "selection",
        "target_kinds",
        "applicable_contracts",
        "baselines",
        "metrics"
      ],
      "title": "ScenarioSpec",
      "type": "object"
    },
    "SelectionSpec": {
      "additionalProperties": false,
      "properties": {
        "fit_partition": {
          "const": "train",
          "default": "train",
          "title": "Fit Partition",
          "type": "string"
        },
        "items": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "method": {
          "enum": [
            "sha256_rank",
            "support_desc_stable_id",
            "all"
          ],
          "title": "Method",
          "type": "string"
        },
        "partition_limits": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Partition Limits",
          "type": "object"
        },
        "schema_version": {
          "const": "tabu.eval-selection.v1",
          "default": "tabu.eval-selection.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stable_id_tiebreak": {
          "const": true,
          "default": true,
          "title": "Stable Id Tiebreak",
          "type": "boolean"
        },
        "users": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Users"
        }
      },
      "required": [
        "method"
      ],
      "title": "SelectionSpec",
      "type": "object"
    },
    "TargetKind": {
      "enum": [
        "numeric",
        "categorical"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "TaskKind": {
      "enum": [
        "supervised_classification",
        "supervised_regression",
        "table_completion",
        "graph_completion",
        "recsys_completion"
      ],
      "title": "TaskKind",
      "type": "string"
    }
  },
  "$id": "https://research.wehub.us/schemas/eval-suite.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_pilot": {
      "const": "one_train_validation_unissued",
      "default": "one_train_validation_unissued",
      "title": "Allowed Pilot",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/EvaluationBudget"
    },
    "claim_boundary": {
      "minLength": 1,
      "title": "Claim Boundary",
      "type": "string"
    },
    "composite_score": {
      "const": false,
      "default": false,
      "title": "Composite Score",
      "type": "boolean"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "frozen_variables": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Frozen Variables",
      "type": "array"
    },
    "report_mean_std": {
      "const": true,
      "default": true,
      "title": "Report Mean Std",
      "type": "boolean"
    },
    "report_per_seed": {
      "const": true,
      "default": true,
      "title": "Report Per Seed",
      "type": "boolean"
    },
    "retain_per_example_scores": {
      "const": true,
      "default": true,
      "title": "Retain Per Example Scores",
      "type": "boolean"
    },
    "retain_raw_predictions": {
      "const": true,
      "default": true,
      "title": "Retain Raw Predictions",
      "type": "boolean"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioSpec"
      },
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "tabu.eval-suite.v1",
      "default": "tabu.eval-suite.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "frozen_v0",
      "enum": [
        "frozen_v0",
        "preregistered"
      ],
      "title": "Status",
      "type": "string"
    },
    "suite_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_version": {
      "default": "0.1.0",
      "enum": [
        "0.1.0",
        "0.2.0"
      ],
      "title": "Suite Version",
      "type": "string"
    },
    "test_sweeps_allowed": {
      "const": false,
      "default": false,
      "title": "Test Sweeps Allowed",
      "type": "boolean"
    },
    "variable_under_test": {
      "const": "model_contract_or_artifact",
      "default": "model_contract_or_artifact",
      "title": "Variable Under Test",
      "type": "string"
    }
  },
  "required": [
    "suite_id",
    "description",
    "frozen_variables",
    "scenarios",
    "claim_boundary"
  ],
  "title": "EvalSuiteSpec",
  "type": "object"
}
