      "title": "Result Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "tabu.eval-result.v2",
