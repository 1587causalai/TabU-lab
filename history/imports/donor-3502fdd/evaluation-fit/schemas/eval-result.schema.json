          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "base_example_id",
        "perturbed_example_sha256",
        "expected_relation",
        "base_prediction",
        "perturbed_prediction",
        "passed"
      ],
      "title": "TopologyCheckResult",
      "type": "object"
    },
    "TopologyRelation": {
      "enum": [
        "equal",
        "different"
      ],
      "title": "TopologyRelation",
      "type": "string"
    }
  },
  "$id": "https://research.wehub.us/schemas/eval-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
