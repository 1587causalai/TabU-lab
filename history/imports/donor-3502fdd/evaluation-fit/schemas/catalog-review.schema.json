{
  "$defs": {
    "CatalogObjectKind": {
      "enum": [
        "model_contract",
        "experiment",
        "run",
        "run_attempt",
        "receipt",
        "model_artifact",
        "dataset_snapshot",
        "eval_suite",
        "eval_result",
        "eval_comparison",
        "review",
        "claim",
        "verification_suite",
        "verification_result"
      ],
      "title": "CatalogObjectKind",
      "type": "string"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "schema_version": {
          "const": "tabu.catalog-evidence-pointer.v1",
          "default": "tabu.catalog-evidence-pointer.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "kind": {
          "$ref": "#/$defs/CatalogObjectKind"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "tabu.catalog-object-ref.v1",
          "default": "tabu.catalog-object-ref.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ReviewDecision": {
      "enum": [
        "pending",
        "approved",
        "changes_requested",
        "rejected"
      ],
      "title": "ReviewDecision",
      "type": "string"
    }
  },
  "$id": "https://research.wehub.us/schemas/catalog-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "developer_identity": {
      "minLength": 1,
      "title": "Developer Identity",
      "type": "string"
    },
    "gong_approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidencePointer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report": {
      "$ref": "#/$defs/EvidencePointer"
    },
    "review_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewer_identity": {
      "minLength": 1,
      "title": "Reviewer Identity",
      "type": "string"
    },
    "schema_version": {
      "const": "tabu.review.v1",
      "default": "tabu.review.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Subjects",
      "type": "array"
    }
  },
  "required": [
    "review_id",
    "subjects",
    "developer_identity",
    "reviewer_identity",
    "decision",
    "report"
  ],
  "title": "ReviewRecord",
  "type": "object"
}
